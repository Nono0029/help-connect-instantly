{
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/conditions",
      "destination": "/conditions.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
